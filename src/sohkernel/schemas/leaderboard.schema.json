{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["estimator","track","protocol","metrics","verdicts"],
    "properties": {
      "estimator": {"type":"string"},
      "featureset": {"type":"string"},
      "track": {"enum":["unified","byo"]},
      "protocol": {"type":"string"},
      "metrics": {"type":"object"},
      "verdicts": {"type":"object"},
      "confidence_intervals": {
        "type": "object",
        "required": ["status", "unit"],
        "properties": {
          "status": {"enum": ["available", "unavailable"]},
          "unit": {"enum": ["asset"]},
          "intervals": {"type": "object"}
        }
      },
      "units": {
        "type": "object",
        "required": ["attempted", "succeeded", "failed", "outcome"],
        "properties": {
          "attempted": {"type":"integer", "minimum": 0},
          "succeeded": {"type":"integer", "minimum": 0},
          "failed": {"type":"integer", "minimum": 0},
          "outcome": {"enum": ["complete", "partial", "failed"]}
        }
      }
    }
  }
}
