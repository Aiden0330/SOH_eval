{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sohbench.local/schemas/prediction-record.schema.json",
  "title": "PredictionRecord",
  "type": "object",
  "required": [
    "run_id",
    "candidate_id",
    "featureset",
    "protocol",
    "fold",
    "seed",
    "dataset",
    "cell_id",
    "cycle_index",
    "sample_id",
    "y_pred"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "featureset": {"type": "string", "minLength": 1},
    "protocol": {"type": "string", "minLength": 1},
    "fold": {"type": "integer", "minimum": 0, "maximum": 1.7976931348623157e308},
    "seed": {"type": "integer", "minimum": -1.7976931348623157e308, "maximum": 1.7976931348623157e308},
    "dataset": {"type": "string", "minLength": 1},
    "cell_id": {"type": "string", "minLength": 1},
    "cycle_index": {"type": "integer", "minimum": 0, "maximum": 1.7976931348623157e308},
    "sample_id": {"type": "string", "minLength": 1},
    "y_pred": {"type": "number", "minimum": -1.7976931348623157e308, "maximum": 1.7976931348623157e308},
    "y_true": {"type": ["number", "null"], "minimum": -1.7976931348623157e308, "maximum": 1.7976931348623157e308},
    "interval_low": {"type": ["number", "null"], "minimum": -1.7976931348623157e308, "maximum": 1.7976931348623157e308},
    "interval_high": {"type": ["number", "null"], "minimum": -1.7976931348623157e308, "maximum": 1.7976931348623157e308},
    "predict_ms": {"type": ["number", "null"], "minimum": 0, "maximum": 1.7976931348623157e308},
    "abstained": {"type": ["boolean", "null"]},
    "status": {"type": ["string", "null"]}
  },
  "dependentRequired": {
    "interval_low": ["interval_high"],
    "interval_high": ["interval_low"]
  },
  "allOf": [
    {
      "if": {"required": ["interval_low", "interval_high"]},
      "then": {
        "oneOf": [
          {
            "properties": {
              "interval_low": {"type": "null"},
              "interval_high": {"type": "null"}
            }
          },
          {
            "properties": {
              "interval_low": {"type": "number"},
              "interval_high": {"type": "number"}
            }
          }
        ]
      }
    }
  ],
  "additionalProperties": true
}
