{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sohbench.local/schemas/evidence-pack.schema.json",
  "title": "EvidencePack",
  "type": "object",
  "required": ["schema_version", "run_id", "artifacts"],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))(?![Ee][Vv][Ii][Dd][Ee][Nn][Cc][Ee]-[Pp][Aa][Cc][Kk]\\.[Jj][Ss][Oo][Nn](?:\\.[Tt][Mm][Pp])?$)[^/]+(?:/[^/]+)*$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
